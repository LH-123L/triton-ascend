ARG BASE_IMAGE
FROM ${BASE_IMAGE}

COPY --chown=root:root --chmod=555 \
    docker/copyright.sh \
    /etc/profile.d/copyright.sh

# Fail the build if the copied file cannot be executed. This RUN is evaluated
# for the target platform by the CI matrix.
RUN set -eux; \
    test "$(stat -c '%U:%G %a' /etc/profile.d/copyright.sh)" = "root:root 555"; \
    bash /etc/profile.d/copyright.sh >/dev/null
